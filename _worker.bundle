  await env.PULSE_KV.put(
    `sub:${email}:${domain}`,
    JSON.stringify({
      email,
      domain,
      plan: "pro",
      // MSP seats get Pro-level scans
      active: true,
      stripe_session_id: msp.stripe_session_id,
      source: "msp",
      created_at: now
    })
  );
  await env.PULSE_KV.put(
    `shield:${email}:${domain}`,
    JSON.stringify({
      email,
      domain,
      plan: "pro",
      active: true,
      stripe_session_id: msp.stripe_session_id,
      source: "msp",
      created_at: now
    })
  );
  msp.clients = [...clients, domain];
  await env.PULSE_KV.put(`msp:${email}`, JSON.stringify(msp));
  return json({
    ok: true,
    domain,
    seats_used: msp.clients.length,
    seats_total: MSP_MAX_SEATS
  });
}
