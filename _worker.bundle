// api/webhooks/stripe-brandguard.js
async function verifyStripeSignature(rawBody, sigHeader, secret) {
  if (!sigHeader || !secret) return false;
  try {
    const parts = {};
    for (const c of sigHeader.split(",")) {
      const i = c.indexOf("=");
      if (i > 0) parts[c.slice(0, i)] = c.slice(i + 1);
    }
    if (!parts.t || !parts.v1) return false;
    const payload = `${parts.t}.${rawBody}`;
    const key = await crypto.subtle.importKey(
      "raw",
      new TextEncoder().encode(secret),
      { name: "HMAC", hash: "SHA-256" },
      false,
      ["sign"]
    );
    const sig = await crypto.subtle.sign("HMAC", key, new TextEncoder().encode(payload));
    const computed = Array.from(new Uint8Array(sig)).map((b2) => b2.toString(16).padStart(2, "0")).join("");
    const a = new TextEncoder().encode(computed);
    const b = new TextEncoder().encode(parts.v1);
    if (a.length !== b.length) return false;
    let diff = 0;
    for (let i = 0; i < a.length; i++) diff |= a[i] ^ b[i];
    return diff === 0;
  } catch {
    return false;
  }
}
__name(verifyStripeSignature, "verifyStripeSignature");
