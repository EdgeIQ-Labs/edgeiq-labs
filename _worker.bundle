          <div class="doc-name">DPIA Documentation</div>
          <div class="doc-meta">Updated Aug 22, 2026 \u2022 PDF 3.2 MB</div>
          <span class="doc-status doc-review">Under Review</span>
        </div>
        <div class="doc-card">
          <div class="doc-icon">\u{1F6A8}</div>
          <div class="doc-name">Incident Response Plan</div>
          <div class="doc-meta">Updated Oct 05, 2026 \u2022 PDF 1.8 MB</div>
