<script>
function formatEnv(sort){var raw=document.getElementById('env-input').value;var lines=raw.split('\n');var comments=[];var vars=[];lines.forEach(function(line){var trimmed=line.trim();if(!trimmed||trimmed.startsWith('#')){comments.push(trimmed);}else{var eqIdx=trimmed.indexOf('=');if(eqIdx>0){vars.push({key:trimmed.substring(0,eqIdx).trim(),val:trimmed.substring(eqIdx+1).trim()});}else{comments.push('# '+trimmed);}}});if(sort)vars.sort(function(a,b){return a.key.localeCompare(b.key);});var maxKeyLen=0;vars.forEach(function(v){if(v.key.length>maxKeyLen)maxKeyLen=v.key.length;});var out=[];comments.forEach(function(c){if(c)out.push(c);});if(out.length&&vars.length)out.push('');vars.forEach(function(v){out.push(v.key.padEnd(maxKeyLen)+' = '+v.val);});show(out.join('\n'));}
function redactValues(){var raw=document.getElementById('env-input').value;var lines=raw.split('\n');var out=lines.map(function(line){var trimmed=line.trim();if(!trimmed||trimmed.startsWith('#'))return line;var eqIdx=trimmed.indexOf('=');if(eqIdx>0){return trimmed.substring(0,eqIdx+1)+' [REDACTED]';}return line;});show(out.join('\n'));}
function show(t){document.getElementById('result-text').innerHTML='<button class="copy-corner" onclick="copyResult()">Copy</button>'+esc(t);document.getElementById('output').style.display='block';document.getElementById('output').scrollIntoView({behavior:'smooth',block:'start'});}
function copyResult(){var t=document.getElementById('result-text').textContent.replace('Copy','').trim();navigator.clipboard.writeText(t);var b=document.querySelector('.copy-corner');b.textContent='Copied!';setTimeout(function(){b.textContent='Copy'},1500);}
function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
</script>
