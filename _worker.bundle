async function onRequest28(context) {
  if (context.request.method === "OPTIONS") {
    return new Response(null, { status: 204, headers: CORS_HEADERS24 });
  }
  if (context.request.method !== "GET") {
    return json28({ error: "Method not allowed" }, 405);
  }
  const kv = context.env.SHIELDVERIFY_KV;
  const jwtSecret = context.env.SHIELDVERIFY_JWT_SECRET || "shieldverify-dev-secret-change-in-prod";
  if (!kv) return json28({ error: "KV namespace not bound" }, 500);
  const authHeader = context.request.headers.get("Authorization");
  if (!authHeader || !authHeader.startsWith("Bearer ")) return json28({ error: "Authorization required" }, 401);
  const user = await verifyJWT11(authHeader.slice(7), jwtSecret);
  if (!user) return json28({ error: "Invalid or expired token" }, 401);
  try {
    const serversList = await kv.list({ prefix: `servers:${user.sub}:` });
    const servers = [];
    for (const key of serversList.keys) {
      const server = await kv.get(key.name, "json");
      if (server) servers.push(server);
    }
    const testsList = await kv.list({ prefix: `tests:${user.sub}:` });
    const tests = [];
    for (const key of testsList.keys) {
      const test = await kv.get(key.name, "json");
      if (test) tests.push(test);
    }
    tests.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
    const totalTests = tests.length;
    const passedTests = tests.filter((t) => t.status === "passed").length;
    const failedTests = tests.filter((t) => t.status === "failed").length;
    const avgResilience = tests.length > 0 ? Math.round(tests.reduce((sum, t) => sum + (t.resilienceScore || 0), 0) / tests.length) : 0;
    return json28({
      user: {
        id: user.sub,
        email: user.email,
        name: user.name,
        tier: user.tier
      },
      servers,
      tests: tests.slice(0, 50),
      stats: {
        totalServers: servers.length,
        totalTests,
        passedTests,
        failedTests,
        passRate: totalTests > 0 ? Math.round(passedTests / totalTests * 100) : 0,
        avgResilienceScore: avgResilience
      }
    });
  } catch (err) {
    console.error("Dashboard error:", err);
    return json28({ error: "Dashboard fetch failed", message: err.message }, 500);
  }
}
