      const activeOnly = url.searchParams.get("active") !== "false";
      const query = activeOnly ? 'SELECT * FROM incidents WHERE page_id = (SELECT id FROM pages WHERE slug = ?) AND status NOT IN ("resolved", "completed") ORDER BY created_at DESC' : "SELECT * FROM incidents WHERE page_id = (SELECT id FROM pages WHERE slug = ?) ORDER BY created_at DESC LIMIT 50";
      const incidents = await env.STATUSPAGE_DB.prepare(query).bind(pageSlug).all();
      return json37(incidents.results || []);
    }
    if (path.match(/^\/pages\/[^/]+\/subscribe$/) && method === "POST") {
      const pageSlug = path.split("/")[2];
      const body = await request.json();
      const { email } = body;
      if (!email) return error("email required");
      const page = await env.STATUSPAGE_DB.prepare("SELECT id FROM pages WHERE slug = ?").bind(pageSlug).first();
      if (!page) return error("page not found", 404);
