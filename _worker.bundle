async function onRequestGet5({ request, env }) {
  if (!env.PULSE_KV) return json9({ error: "Storage not configured" }, 500);
  const url = new URL(request.url);
  const orderId = url.searchParams.get("order");
  const sessionId = url.searchParams.get("session_id");
  if (!orderId) return json9({ error: "Missing order ID" }, 400);
  const raw = await env.PULSE_KV.get(`report:${orderId}`);
  if (!raw) return json9({ error: "Order not found or expired" }, 404);
  const order = JSON.parse(raw);
  if (order.status === "paid") return json9({ ok: true, order });
  if (!sessionId) return json9({ error: "Payment not confirmed" }, 403);
  if (!env.STRIPE_SECRET_KEY) return json9({ error: "Stripe not configured" }, 500);
  const stripeResp = await fetch(`https://api.stripe.com/v1/checkout/sessions/${sessionId}`, {
    headers: { "Authorization": `Bearer ${env.STRIPE_SECRET_KEY}` }
  });
  if (!stripeResp.ok) return json9({ error: "Could not verify payment" }, 502);
  const session = await stripeResp.json();
  if (session.payment_status !== "paid") {
    return json9({ error: "Payment not completed" }, 403);
  }
  const updated = { ...order, status: "paid", paid_at: (/* @__PURE__ */ new Date()).toISOString() };
  await env.PULSE_KV.put(`report:${orderId}`, JSON.stringify(updated), {
    expirationTtl: 60 * 60 * 24 * 30
    // extend to 30 days after payment
  });
  return json9({ ok: true, order: updated });
}
