<script>
// Mock API key validation
const VALID_KEYS = ['sk-vendor-demo', 'sk-vendor-test', 'sk-vendor-edgeiq'];

function handleLogin() {
  const input = document.getElementById('api-key-input');
  const error = document.getElementById('login-error');
  const key = input.value.trim();
  
  if (!key || !key.startsWith('sk-vendor-')) {
    error.style.display = 'block';
    error.textContent = 'API key must start with sk-vendor-';
    return;
  }
  
  // Accept any properly formatted key for demo
  if (key.length >= 12) {
    document.getElementById('login-screen').style.display = 'none';
    document.getElementById('app').style.display = 'block';
    renderMatrixDots();
  } else {
    error.style.display = 'block';
    error.textContent = 'Invalid API key. Please try again.';
  }
}

function handleLogout() {
  document.getElementById('app').style.display = 'none';
  document.getElementById('login-screen').style.display = 'flex';
  document.getElementById('api-key-input').value = '';
  document.getElementById('login-error').style.display = 'none';
}

// Enter key support
document.getElementById('api-key-input').addEventListener('keydown', function(e) {
  if (e.key === 'Enter') handleLogin();
});

// Generate scatter plot dots
function renderMatrixDots() {
  const container = document.getElementById('risk-matrix');
  const colors = ['var(--danger)', 'var(--warning)', 'var(--accent)', 'var(--success)'];
  const weights = [0.1, 0.25, 0.35, 0.3]; // distribution
  
  for (let i = 0; i < 40; i++) {
    const dot = document.createElement('div');
    dot.className = 'matrix-dot';
    
    // Weighted random color
    let r = Math.random(), cumulative = 0, colorIdx = 0;
    for (let j = 0; j < weights.length; j++) {
      cumulative += weights[j];
      if (r <= cumulative) { colorIdx = j; break; }
    }
    
    dot.style.background = colors[colorIdx];
    dot.style.left = (5 + Math.random() * 90) + '%';
    dot.style.top = (5 + Math.random() * 90) + '%';
    dot.style.width = (6 + Math.random() * 8) + 'px';
    dot.style.height = dot.style.width;
    container.appendChild(dot);
  }
}

// Nav item click handling
document.querySelectorAll('.nav-item').forEach(item => {
  item.addEventListener('click', function() {
    document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
    this.classList.add('active');
  });
});
<\/script>

<script>
// Real backend integration
const SERVICE_API = '/api/vendor-risk-api';
const API_KEY_STORAGE = 'vendor-risk_api_key';

async function fetchStats(apiKey) {
  try {
    const resp = await fetch(\`\${SERVICE_API}?action=stats\`, {
      headers: { 'Authorization': \`Bearer \${apiKey}\` }
    });
    if (resp.ok) return await resp.json();
  } catch(e) { console.warn('API fetch failed, using demo data:', e); }
  return null;
}

async function fetchAccount(apiKey) {
  try {
    const resp = await fetch(\`\${SERVICE_API}?action=account\`, {
      headers: { 'Authorization': \`Bearer \${apiKey}\` }
    });
    if (resp.ok) return await resp.json();
  } catch(e) { console.warn('Account fetch failed:', e); }
  return null;
}

// After login, try to load real data
const origLoginHandler = window.handleLogin || null;
window.handleLogin = async function(apiKey) {
  localStorage.setItem(API_KEY_STORAGE, apiKey);
  // Try real API first
  const stats = await fetchStats(apiKey);
  const account = await fetchAccount(apiKey);
  if (stats && account) {
    console.log('\u2705 Connected to real backend');
    document.title += ' [LIVE]';
  } else {
    console.log('\u2139\uFE0F Using demo mode (no backend data yet)');
  }
  if (origLoginHandler) origLoginHandler(apiKey);
};
<\/script>

</body>
</html>`;
