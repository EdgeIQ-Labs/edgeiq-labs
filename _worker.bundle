async function onRequest(context) {
  if (context.request.method === "OPTIONS") {
    return new Response(null, { status: 204, headers: CORS_HEADERS });
  }
  if (context.request.method !== "POST") {
    return json2({ error: "Method not allowed" }, 405);
  }
  const kv = context.env.SHIELDBUILD_KV;
  const jwtSecret = context.env.SHIELDBUILD_JWT_SECRET || "shieldbuild-dev-secret-change-in-prod";
  if (!kv) {
    return json2({ error: "KV namespace not bound" }, 500);
  }
  try {
    const body = await context.request.json();
    const { email, password } = body;
    if (!email || !password) {
      return json2({ error: "Email and password required" }, 400);
    }
    const userKey = `users:${email.toLowerCase()}`;
    const userData = await kv.get(userKey, "json");
    if (!userData) {
      return json2({ error: "Invalid credentials" }, 401);
    }
    if (userData.password !== password) {
      return json2({ error: "Invalid credentials" }, 401);
    }
    const payload = {
      sub: userData.id,
      email: userData.email,
      tier: userData.tier,
      name: userData.name,
      iat: Math.floor(Date.now() / 1e3),
      exp: Math.floor(Date.now() / 1e3) + 7 * 24 * 60 * 60
      // 7 days
    };
    const token = await createJWT(payload, jwtSecret);
    return json2({
      token,
      user: {
        id: userData.id,
        email: userData.email,
        name: userData.name,
        tier: userData.tier
      }
    });
  } catch (err) {
    console.error("Login error:", err);
    return json2({ error: "Authentication failed", message: err.message }, 500);
  }
}
