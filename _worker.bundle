    <div class="sidebar-footer">
      <button class="logout-btn" onclick="handleLogout()">
        <svg class="nav-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Log Out
      </button>
    </div>
  </aside>

  <!-- Main Content -->
  <main class="main">
    <div class="page-header">
      <h1>Dashboard <span class="plan-badge">$99/mo Pro</span></h1>
      <p>Compliance verification overview &mdash; Last updated Nov 5, 2026 09:41 EST</p>
    </div>

    <!-- Stats -->
    <div class="stats-grid">
