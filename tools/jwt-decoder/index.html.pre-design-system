<script>
var CLAIM_DESC = {
  iss: 'Issuer — who created and signed this token',
  sub: 'Subject — the principal (user ID, service account)',
  aud: 'Audience — intended recipient(s) of this token',
  exp: 'Expiration — token is invalid after this time',
  nbf: 'Not Before — token is invalid before this time',
  iat: 'Issued At — when the token was created',
  jti: 'JWT ID — unique identifier for this token',
  typ: 'Type — token type (usually JWT)',
  alg: 'Algorithm — signing algorithm used',
  scope: 'Scope — permissions granted by this token',
  roles: 'Roles — user roles or groups',
  email: 'Email — user email address',
  name: 'Name — display name',
  kid: 'Key ID — identifies the signing key'
};

function decodeJWT() {
  var raw = document.getElementById('jwt-input').value.trim();
  if (!raw) return;
  // Strip Bearer prefix if present
  raw = raw.replace(/^[Bb]earer\s+/, '');
  var parts = raw.split('.');
  if (parts.length < 2) {
    alert('Invalid JWT format. Expected at least header.payload.signature separated by dots.');
    return;
  }
  try {
    var header = JSON.parse(atob(parts[0].replace(/-/g,'+').replace(/_/g,'/')));
    var payload = JSON.parse(atob(parts[1].replace(/-/g,'+').replace(/_/g,'/')));
    document.getElementById('header-json').textContent = JSON.stringify(header, null, 2);
    document.getElementById('payload-json').textContent = JSON.stringify(payload, null, 2);
    document.getElementById('sig-block').textContent = parts[2] || '(none — unsigned token)';

    // Build claims table
    var html = '';
    var keys = Object.keys(payload);
    keys.forEach(function(k) {
      var val = payload[k];
      var desc = CLAIM_DESC[k] || '';
      var extra = '';
      // Time claims
      if ((k === 'exp' || k === 'nbf' || k === 'iat') && typeof val === 'number') {
        var d = new Date(val * 1000);
        var now = Math.floor(Date.now() / 1000);
        var diff = val - now;
        var timeStr = d.toLocaleString();
        if (k === 'exp') {
          if (diff < 0) extra = '<span class="status-pill status-bad">EXPIRED ' + Math.abs(Math.floor(diff/3600)) + 'h ago</span>';
          else if (diff < 300) extra = '<span class="status-pill status-warn">expires in ' + Math.floor(diff/60) + ' min</span>';
          else extra = '<span class="status-pill status-ok">valid for ' + Math.floor(diff/3600) + 'h</span>';
        } else if (k === 'nbf') {
          if (diff > 0) extra = '<span class="status-pill status-warn">not valid for ' + Math.floor(diff/60) + ' min</span>';
          else extra = '<span class="status-pill status-ok">active</span>';
        }
        val = timeStr + ' (' + val + ')';
      }
      // Array values
      if (Array.isArray(val)) val = val.join(', ');
      // Objects
      if (typeof val === 'object' && val !== null) val = JSON.stringify(val);
      html += '<div class="claim-row"><div><div class="claim-name">' + esc(k) + '</div>' +
        (desc ? '<div class="claim-desc">' + desc + '</div>' : '') +
        '</div><div class="claim-val">' + esc(String(val)) + extra + '</div></div>';
    });
    document.getElementById('claims-table').innerHTML = html;
    document.getElementById('output').style.display = 'block';
    document.getElementById('output').scrollIntoView({behavior:'smooth',block:'start'});
  } catch(e) {
    alert('Failed to decode JWT: ' + e.message + '. Check that the token is valid Base64URL.');
  }
}

function esc(s) { return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function toggleFaq(el) { var a = el.nextElementSibling; var open = el.classList.toggle('open'); a.style.display = open ? 'block' : 'none'; }
document.getElementById('jwt-input').addEventListener('keydown', function(e) { if (e.key === 'Enter' && e.ctrlKey) decodeJWT(); });
</script>
