  if (!resendKey) return json27({ error: "Email service not configured" }, 500);
  try {
    const body = await context.request.text();
    const event = JSON.parse(body);
    if (event.type !== "checkout.session.completed") {
      return json27({ received: true, skipped: event.type });
    }
    const session = event.data.object;
    const customerEmail = session.customer_details?.email;
    const amountTotal = session.amount_total;
    const tier = amountTotal >= 29900 ? "pro" : "starter";
    const planName = tier === "pro" ? "Pro" : "Starter";
    const monthlyPrice = tier === "pro" ? 299 : 149;
    if (!customerEmail) {
      return json27({ error: "No customer email in session" }, 400);
    }
    const userKey = `users:${customerEmail.toLowerCase()}`;
    let userData = await kv.get(userKey, "json");
    if (!userData) {
      const userId = crypto.randomUUID();
      const tempPassword = "TempPass-" + Math.random().toString(36).slice(-8) + "!";
      userData = {
        id: userId,
        email: customerEmail.toLowerCase(),
        name: customerEmail.split("@")[0],
        password: tempPassword,
        tier,
        stripeCustomerId: session.customer,
        subscriptionId: session.subscription,
        createdAt: (/* @__PURE__ */ new Date()).toISOString()
      };
      await kv.put(userKey, JSON.stringify(userData));
      const usersIndex = await kv.get("users:index", "json") || [];
      usersIndex.push({ id: userId, email: customerEmail.toLowerCase(), tier });
      await kv.put("users:index", JSON.stringify(usersIndex));
    } else {
      userData.tier = tier;
      userData.stripeCustomerId = session.customer;
      userData.subscriptionId = session.subscription;
      await kv.put(userKey, JSON.stringify(userData));
    }
    const emailHtml = `
      <div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; max-width: 600px; margin: 0 auto; color: #1a1a2e;">
        <div style="background: #0c0c14; padding: 32px; border-radius: 8px 8px 0 0;">
          <h1 style="color: #ffffff; margin: 0; font-size: 24px;">Welcome to ShieldInvoice</h1>
        </div>
        <div style="background: #f8f9fa; padding: 32px; border-radius: 0 0 8px 8px; border: 1px solid #e2e8f0; border-top: none;">
          <p>Hi ${userData.name},</p>
          <p>Thank you for subscribing to <strong>ShieldInvoice ${planName}</strong>. Your payment of <strong>$${monthlyPrice}/mo</strong> has been confirmed.</p>
          
          <div style="background: #e8f4fd; padding: 16px; border-radius: 6px; margin: 24px 0; border-left: 4px solid #3b82f6;">
            <strong>Your Login Credentials:</strong><br/>
            Email: ${customerEmail}<br/>
            Temporary Password: <code>${userData.password}</code><br/><br/>
            <a href="https://edgeiqlabs.com/shieldinvoice/dashboard.html" style="display: inline-block; background: #2563eb; color: white; padding: 12px 24px; border-radius: 6px; text-decoration: none; font-weight: 600;">Go to Dashboard</a>
          </div>

          <h3 style="margin-top: 24px; color: #0c0c14;">What's included in ${planName}:</h3>
          <ul style="line-height: 1.8;">
            ${tier === "pro" ? "<li>Unlimited invoice processing</li><li>QuickBooks Online export</li><li>Advanced anomaly detection</li><li>Priority support</li>" : "<li>100 invoices per month</li><li>Email invoice ingest</li><li>CSV export</li><li>Standard support</li>"}
          </ul>

          <p style="margin-top: 24px; font-size: 14px; color: #64748b;">
            Questions? Reply to this email or contact us at <a href="mailto:billing@edgeiqlabs.com" style="color: #2563eb;">billing@edgeiqlabs.com</a>.
          </p>
        </div>
      </div>
    `;
    const emailResponse = await fetch("https://api.resend.com/emails", {
      method: "POST",
      headers: {
        "Authorization": `Bearer ${resendKey}`,
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        from: "EdgeIQ Labs Billing <billing@edgeiqlabs.com>",
        to: [customerEmail],
        subject: `Welcome to ShieldInvoice \u2014 ${planName} Plan`,
        html: emailHtml
      })
    });
    if (!emailResponse.ok) {
      const errText = await emailResponse.text();
      console.error("Resend API error:", errText);
      return json27({ error: "Failed to send welcome email", details: errText }, 500);
    }
    const emailResult = await emailResponse.json();
    console.log(`Welcome email sent to ${customerEmail}: ${emailResult.id}`);
    return json27({
      received: true,
      email_sent: true,
      email_id: emailResult.id,
      customer: customerEmail,
      tier,
      user_created: !userData.subscriptionId
    });
  } catch (err) {
    console.error("Webhook processing error:", err);
    return json27({ error: "Internal server error", message: err.message }, 500);
  }
}
