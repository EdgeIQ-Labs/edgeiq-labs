.sidebar-nav { flex: 1; padding: 16px 12px; display: flex; flex-direction: column; gap: 4px; }
.nav-item { display: flex; align-items: center; gap: 12px; padding: 10px 12px; border-radius: 8px; font-size: 14px; color: var(--text-muted); cursor: pointer; transition: all 0.2s; }
.nav-item:hover, .nav-item.active { background: rgba(61,217,255,0.08); color: var(--text); }
.nav-item.active { color: var(--accent); }
