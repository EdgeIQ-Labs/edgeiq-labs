      </div>
    </div>
  </main>
</div>

<script>
  const VALID_KEY_PREFIX = 'sk-';
  const loginScreen = document.getElementById('login-screen');
  const app = document.getElementById('app');
  const errorEl = document.getElementById('login-error');
  const keyInput = document.getElementById('api-key-input');

  // Check session
  if (sessionStorage.getItem('sv_auth') === 'true') {
    showApp();
  }

  keyInput.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') handleLogin();
  });

  function handleLogin() {
    const key = keyInput.value.trim();
    if (!key) {
      errorEl.textContent = 'Please enter an API key.';
      return;
    }
    if (!key.startsWith(VALID_KEY_PREFIX)) {
      errorEl.textContent = 'Invalid key format. Expected sk-live-... or sk-test-...';
      return;
    }
    if (key.length < 12) {
      errorEl.textContent = 'API key too short. Check and try again.';
      return;
    }
    // Mock auth success
    sessionStorage.setItem('sv_auth', 'true');
    errorEl.textContent = '';
    showApp();
  }

  function showApp() {
    loginScreen.classList.add('hidden');
    app.classList.add('visible');
    setTimeout(function() { loginScreen.style.display = 'none'; }, 300);
  }

  function handleLogout() {
    sessionStorage.removeItem('sv_auth');
    location.reload();
  }

  function toggleSidebar() {
    document.getElementById('sidebar').classList.toggle('open');
  }

  // Nav items
  document.querySelectorAll('.nav-item').forEach(function(item) {
    item.addEventListener('click', function() {
      document.querySelectorAll('.nav-item').forEach(function(n) { n.classList.remove('active'); });
      this.classList.add('active');
      // Close mobile sidebar
      document.getElementById('sidebar').classList.remove('open');
    });
  });

  function downloadReport(id) {
    // Mock download
    var btn = event.target;
    var orig = btn.textContent;
    btn.textContent = 'Downloading...';
    btn.disabled = true;
    setTimeout(function() {
      btn.textContent = orig;
      btn.disabled = false;
      alert('Demo: Report ' + id + '.pdf would download here.');
    }, 800);
  }
<\/script>

<script>
// Real backend integration
const SERVICE_API = '/api/shieldverify-api';
const API_KEY_STORAGE = 'shieldverify_api_key';

async function fetchStats(apiKey) {
  try {
    const resp = await fetch(\`\${SERVICE_API}?action=stats\`, {
      headers: { 'Authorization': \`Bearer \${apiKey}\` }
    });
    if (resp.ok) return await resp.json();
  } catch(e) { console.warn('API fetch failed, using demo data:', e); }
  return null;
}

async function fetchAccount(apiKey) {
  try {
    const resp = await fetch(\`\${SERVICE_API}?action=account\`, {
      headers: { 'Authorization': \`Bearer \${apiKey}\` }
    });
    if (resp.ok) return await resp.json();
  } catch(e) { console.warn('Account fetch failed:', e); }
  return null;
}

// After login, try to load real data
const origLoginHandler = window.handleLogin || null;
window.handleLogin = async function(apiKey) {
  localStorage.setItem(API_KEY_STORAGE, apiKey);
  // Try real API first
  const stats = await fetchStats(apiKey);
  const account = await fetchAccount(apiKey);
  if (stats && account) {
    console.log('\u2705 Connected to real backend');
    document.title += ' [LIVE]';
  } else {
    console.log('\u2139\uFE0F Using demo mode (no backend data yet)');
  }
  if (origLoginHandler) origLoginHandler(apiKey);
};
<\/script>

</body>
