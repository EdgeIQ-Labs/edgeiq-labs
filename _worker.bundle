  const html = `<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/favicon.png" />
  <title>Status \u2014 EdgeIQ Labs</title>
  <meta name="description" content="Service status and uptime information." />
  <link rel="stylesheet" href="/css/design-system.css?v=13" />
  <style>
    .sp-container { max-width: 720px; margin: 0 auto; padding: 40px 20px; }
    .sp-header { text-align: center; margin-bottom: 40px; }
    .sp-header h1 { font-size: 1.6rem; margin-bottom: 6px; }
    .sp-header p { color: var(--muted); font-size: 0.9rem; }
    .sp-overall { text-align: center; padding: 24px; border-radius: 12px; margin-bottom: 32px; font-weight: 700; font-size: 1.1rem; }
    .sp-overall.operational { background: rgba(61,225,158,0.1); border: 1px solid rgba(61,225,158,0.3); color: #3de19e; }
    .sp-overall.degraded { background: rgba(255,196,0,0.1); border: 1px solid rgba(255,196,0,0.3); color: #ffc400; }
    .sp-overall.outage { background: rgba(255,107,107,0.1); border: 1px solid rgba(255,107,107,0.3); color: #ff6b6b; }
    .sp-components { display: flex; flex-direction: column; gap: 8px; margin-bottom: 40px; }
    .sp-component { display: flex; align-items: center; justify-content: space-between; padding: 14px 18px; background: var(--card); border: 1px solid var(--border); border-radius: 10px; }
    .sp-component-name { font-weight: 600; font-size: 0.92rem; }
    .sp-component-status { font-size: 0.82rem; font-weight: 600; display: flex; align-items: center; gap: 6px; }
    .sp-dot { width: 8px; height: 8px; border-radius: 50%; }
    .sp-dot.operational { background: #3de19e; }
    .sp-dot.degraded { background: #ffc400; }
    .sp-dot.partial_outage { background: #ff8c42; }
    .sp-dot.major_outage { background: #ff6b6b; }
    .sp-dot.maintenance { background: #3dd9ff; }
    .sp-incidents { margin-top: 32px; }
    .sp-incidents h2 { font-size: 1.1rem; margin-bottom: 16px; }
    .sp-incident { background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 18px; margin-bottom: 12px; }
    .sp-incident-header { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
    .sp-incident-title { font-weight: 700; font-size: 0.95rem; }
    .sp-incident-badge { font-size: 0.68rem; padding: 2px 8px; border-radius: 4px; font-weight: 700; text-transform: uppercase; }
    .sp-incident-badge.investigating { background: rgba(255,196,0,0.15); color: #ffc400; }
    .sp-incident-badge.identified { background: rgba(255,140,66,0.15); color: #ff8c42; }
    .sp-incident-badge.monitoring { background: rgba(61,217,255,0.15); color: #3dd9ff; }
    .sp-incident-badge.resolved { background: rgba(61,225,158,0.15); color: #3de19e; }
    .sp-incident-badge.scheduled { background: rgba(61,217,255,0.15); color: #3dd9ff; }
    .sp-incident-body { color: var(--muted); font-size: 0.88rem; line-height: 1.5; }
    .sp-incident-time { color: var(--muted); font-size: 0.75rem; margin-top: 8px; }
    .sp-subscribe { text-align: center; margin-top: 40px; padding: 24px; background: var(--card); border: 1px solid var(--border); border-radius: 12px; }
    .sp-subscribe h3 { font-size: 0.95rem; margin-bottom: 10px; }
    .sp-subscribe-form { display: flex; gap: 8px; justify-content: center; max-width: 400px; margin: 0 auto; }
    .sp-subscribe-form input { flex: 1; background: var(--bg); border: 1px solid var(--border); border-radius: 8px; padding: 10px 14px; color: var(--text); font-size: 0.9rem; outline: none; }
    .sp-subscribe-form input:focus { border-color: var(--accent); }
    .sp-subscribe-form button { background: var(--accent); color: #071018; border: none; border-radius: 8px; padding: 10px 18px; font-weight: 700; cursor: pointer; white-space: nowrap; }
    .sp-powered { text-align: center; margin-top: 40px; font-size: 0.75rem; color: var(--muted); }
    .sp-powered a { color: var(--accent); text-decoration: none; }
    .sp-loading { text-align: center; padding: 60px; color: var(--muted); }
